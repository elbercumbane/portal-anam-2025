			<div class="elementor-widget-wrap elementor-element-populated">
						<div class="elementor-element elementor-element-a775bf7 elementor-widget elementor-widget-elementskit-heading" data-id="a775bf7" data-element_type="widget" data-widget_type="elementskit-heading.default">
				<div class="elementor-widget-container">
					<div class="ekit-wid-con" ><div class="ekit-heading elementskit-section-title-wraper text_left   ekit_heading_tablet-   ekit_heading_mobile-text_center"><h2 class="ekit-heading--title elementskit-section-title ">FAQs</h2></div></div>				</div>
