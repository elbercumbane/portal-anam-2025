# Vercel limita upload a 100 MB por ficheiro - node_modules e dist nao podem ser enviados
# A Vercel corre npm install e npm run build no servidor; o codigo funciona na mesma
node_modules
dist
.angular
.git
.vercel
.vscode
.idea
*.log
.env*
.DS_Store
Thumbs.db

# Nao enviar package-lock.json: foi gerado no Windows e fixa @rollup/rollup-win32-x64-msvc.
# Na Vercel (Linux) o npm install deve resolver dependencias para Linux.
package-lock.json
