{
  "name": "portal-anam-workspace",
  "version": "1.0.0",
  "description": "Workspace do Portal da Associação e Massinga - Frontend e Backend",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm run dev",
    "start:proxy": "node proxy-server.js",
    "start:ngrok": "concurrently \"npm run start:backend\" \"npm run start:frontend:ngrok\" \"npm run start:proxy\"",
    "start:frontend:ngrok": "cd frontend && npm run start:ngrok",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && npm test"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "cors": "^2.8.5"
  },
  "keywords": [
    "angular",
    "frontend",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC"
}

