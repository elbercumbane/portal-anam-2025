{
  "name": "portal-anam-backend",
  "version": "1.0.0",
  "description": "Backend API para Portal da Associação e Massinga",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "db:init": "ts-node src/database/init.ts",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "db:create-admin": "ts-node src/database/create-admin.ts",
    "db:create-admin-auto": "ts-node src/database/create-admin-auto.ts",
    "db:update-admin-email": "ts-node src/database/update-admin-email.ts",
    "db:test-login": "ts-node src/database/test-login.ts",
    "setup": "npm install && npm run db:init && npm run db:seed",
    "setup-completo": "ts-node src/database/setup-completo-auto.ts",
    "create-all": "ts-node src/database/create-all-fixed.ts",
    "create-env": "ts-node create-env.ts",
    "test-connection": "ts-node test-connection.ts",
    "test-insert": "ts-node test-insert-application.ts",
    "check-apps": "ts-node check-applications.ts"
  },
  "keywords": [
    "api",
    "backend",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@vercel/node": "^3.0.0",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2"
  }
}
